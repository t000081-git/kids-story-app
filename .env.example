# Required — free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — ElevenLabs TTS. Without this, narration uses the browser's Web Speech API.
ELEVENLABS_API_KEY=

# Optional — Vercel KV (Upstash Redis). Injected automatically when the KV add-on
# is attached to the project. Needed for cloud saves and permanent share links.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Reserved — LumenPro had no public REST API at build time; not currently used.
LUMENPRO_API_KEY=
